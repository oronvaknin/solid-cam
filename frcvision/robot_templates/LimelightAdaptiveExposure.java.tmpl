/**
 * In-match adaptive exposure for Limelight cameras.
 *
 * <p>Generated by FRC Vision Lab on {{GENERATED_AT}}. Baselines come from the pre-match "Auto light"
 * tune; this class keeps adjusting the exposure <b>during</b> the match.
 *
 * <p><b>How it works.</b> From the robot pose it predicts which field AprilTags the camera should see
 * (in the field of view, close enough, facing the camera). Every ~0.75 s it compares that with what the
 * Limelight actually detected (and how ambiguous the detections were). If detection is good it holds.
 * If not, it steps the exposure (x1.2) and checks whether that helped - if the step made it worse it
 * goes the other way (perturb and observe). First guess: brighter when slow (too dark), darker when
 * driving fast (motion blur).
 *
 * <p><b>Safety.</b> Exposure is limited to baseline x [minFactor, maxFactor]; at most one change per
 * window; nothing is ever saved to the Limelight's disk (no flush), so every reboot / new match starts
 * from the tuned baseline; {@link #setHold(boolean)} freezes it while you aim or shoot; after 5 failed
 * HTTP requests it stops adapting; NetworkTables "AdaptiveExposure/&lt;name&gt;/enabled" is a dashboard
 * kill switch. All HTTP runs on a background thread - the robot loop never blocks.
 *
 * <p><b>Usage</b>
 *
 * <pre>
 * // fields (Robot / RobotContainer)
 * private final LimelightAdaptiveExposure frontExposure =
 *     new LimelightAdaptiveExposure(LimelightAdaptiveExposure.Cameras.{{FIRST_CAMERA}});
 *
 * // robotPeriodic()
 * frontExposure.update(drivetrain.getPose(), drivetrain.getRobotRelativeSpeeds());
 *
 * // autonomousInit() - every match starts from the tuned value
 * frontExposure.resetToBaseline();
 *
 * // optional, while auto-aiming / shooting
 * frontExposure.setHold(isAiming);
 * </pre>
 */
public class LimelightAdaptiveExposure {

  /** Limelight exposure units: 0.01 ms. */
  public static final double UNIT_MS = 0.01;

  /** Per-camera settings. Values below were generated from the app; adjust freely. */
  public static final class Config {
    public final String name; // NetworkTables name, e.g. "limelight" or "limelight-front"
    public final String host; // IP address of the Limelight (static IP recommended)
    public final String exposureKey; // pipeline JSON key for exposure
    public final double baselineRaw; // tuned exposure in Limelight units (0.01 ms)
    public final boolean integerValues;
    public final Transform3d robotToCamera;
    public double hfovDeg = 63.3;
    public double vfovDeg = 49.7;
    public double minFactor = 0.6; // exposure range = baseline x [minFactor, maxFactor]
    public double maxFactor = 2.5;
    public double stepFactor = 1.2;
    public double windowSec = 0.75;
    public double settleSec = 0.2;
    public double maxTagDistance = 4.5; // m - tags further away are not expected
    public double maxViewAngleDeg = 60; // tags seen more obliquely are not expected
    public double fastOmega = 2.0; // rad/s - above this the robot counts as "fast" (blur)
    public double fastSpeed = 2.5; // m/s
    public boolean adaptInAuto = true;
    public boolean adaptInTeleop = true;

    public Config(String name, String host, String exposureKey, double baselineRaw,
        boolean integerValues, Transform3d robotToCamera) {
      this.name = name;
      this.host = host;
      this.exposureKey = exposureKey;
      this.baselineRaw = baselineRaw;
      this.integerValues = integerValues;
      this.robotToCamera = robotToCamera;
    }

    public Config withFov(double hfovDeg, double vfovDeg) {
      this.hfovDeg = hfovDeg;
      this.vfovDeg = vfovDeg;
      return this;
    }

    public Config withRange(double minFactor, double maxFactor) {
      this.minFactor = minFactor;
      this.maxFactor = maxFactor;
      return this;
    }

    public Config withStep(double stepFactor, double windowSec) {
      this.stepFactor = stepFactor;
      this.windowSec = windowSec;
      return this;
    }

    public Config withMaxTagDistance(double meters) {
      this.maxTagDistance = meters;
      return this;
    }

    public Config withModes(boolean auto, boolean teleop) {
      this.adaptInAuto = auto;
      this.adaptInTeleop = teleop;
      return this;
    }
  }

  /** Cameras tuned in FRC Vision Lab. */
  public static final class Cameras {
{{CAMERAS}}
  }

  // =====================================================================================
  /** The decision logic. Pure Java (no WPILib / NetworkTables), so it can be unit tested. */
  public static final class Controller {
    public final double baseline;
    public final double min;
    public final double max;
    public final double step;
    public final double window;
    public final double settle;
    public double goodDetection = 0.9; // >= 90% of expected tags detected
    public double goodAmbiguity = 0.2; // average ambiguity of detections
    public double ambiguityWeight = 0.5;
    public double relaxAfterSec = 6.0; // good this long above baseline -> step back toward baseline
    public double returnAfterSec = 10.0; // no tags this long -> step back toward baseline
    public int minExpectedSamples = 12;
    public int minDetections = 12;
    public double epsilon = 0.02;
    public int badWindowsToAct = 2; // consecutive bad windows before leaving a good exposure (noise filter)

    private double exposure;
    private int dir = 1;
    private double lastScore = Double.NaN;
    private boolean changedLast = false;
    private double windowStart = Double.NaN;
    private double lastChange = -1e9;
    private int expectedSamples;
    private int detectedExpected;
    private int detections;
    private int frames;
    private int fastFrames;
    private double ambiguitySum;
    private double goodTime;
    private double noInfoTime;
    private int badWindows;

    // telemetry
    public double lastDetection = Double.NaN;
    public double lastAmbiguity = Double.NaN;
    public double lastScoreOut = Double.NaN;
    public String state = "BASELINE";

    public Controller(double baseline, double minFactor, double maxFactor, double stepFactor,
        double windowSec, double settleSec) {
      this.baseline = baseline;
      this.min = baseline * minFactor;
      this.max = baseline * maxFactor;
      this.step = stepFactor;
      this.window = windowSec;
      this.settle = settleSec;
      reset();
    }

    public double exposure() {
      return exposure;
    }

    public void reset() {
      exposure = baseline;
      dir = 1;
      lastScore = Double.NaN;
      changedLast = false;
      windowStart = Double.NaN;
      goodTime = 0;
      noInfoTime = 0;
      badWindows = 0;
      clearWindow();
      state = "BASELINE";
    }

    /** One camera frame: tags that should be visible, and detected tag id -> ambiguity. */
    public void addFrame(double now, Set<Integer> expected, Map<Integer, Double> detected, boolean fast) {
      if (Double.isNaN(windowStart)) {
        windowStart = now;
      }
      if (now - lastChange < settle) {
        return; // camera still settling on the new exposure
      }
      frames++;
      if (fast) {
        fastFrames++;
      }
      for (int id : expected) {
        expectedSamples++;
        if (detected.containsKey(id)) {
          detectedExpected++;
        }
      }
      for (double a : detected.values()) {
        detections++;
        ambiguitySum += a;
      }
    }

    /** Call every loop. Returns the new exposure to command, or NaN for "no change". */
    public double update(double now, boolean hold) {
      if (Double.isNaN(windowStart)) {
        windowStart = now;
        return Double.NaN;
      }
      double dt = now - windowStart;
      if (dt < window) {
        return Double.NaN;
      }
      double det = expectedSamples >= minExpectedSamples
          ? (double) detectedExpected / expectedSamples : Double.NaN;
      double amb = detections >= minDetections ? ambiguitySum / detections : Double.NaN;
      boolean fastWindow = frames > 0 && fastFrames * 2 > frames;
      clearWindow();
      windowStart = now;
      lastDetection = det;
      lastAmbiguity = amb;

      if (hold) {
        state = "HOLD";
        changedLast = false;
        return Double.NaN;
      }
      if (Double.isNaN(det) && Double.isNaN(amb)) {
        noInfoTime += dt;
        changedLast = false;
        state = "NO_TAGS";
        if (noInfoTime >= returnAfterSec && Math.abs(exposure / baseline - 1) > 0.02) {
          noInfoTime = 0;
          return towardBaseline(now);
        }
        return Double.NaN;
      }
      noInfoTime = 0;
      double score = (Double.isNaN(det) ? 1.0 : det) - ambiguityWeight * (Double.isNaN(amb) ? 0.0 : amb);
      lastScoreOut = score;
      boolean good = (Double.isNaN(det) || det >= goodDetection)
          && (Double.isNaN(amb) || amb <= goodAmbiguity);
      if (good) {
        goodTime += dt;
        badWindows = 0;
        changedLast = false;
        lastScore = score;
        state = "GOOD";
        if (goodTime >= relaxAfterSec && exposure > baseline * 1.02) {
          goodTime = 0;
          return towardBaseline(now); // less exposure = less blur, when it is safe
        }
        return Double.NaN;
      }
      goodTime = 0;
      badWindows++;
      if (!changedLast && badWindows < badWindowsToAct) {
        state = "WATCH"; // one bad window can be an occlusion - confirm before acting
        lastScore = score;
        return Double.NaN;
      }
      if (changedLast && !Double.isNaN(lastScore)) {
        if (score < lastScore - epsilon) {
          dir = -dir; // the last step made it worse: go back the other way
        }
      } else {
        dir = fastWindow ? -1 : 1; // first guess: blur when fast, otherwise too dark
      }
      double next = clamp(exposure * Math.pow(step, dir));
      if (Math.abs(next - exposure) < 1e-9) {
        dir = -dir; // at a limit
        next = clamp(exposure * Math.pow(step, dir));
      }
      lastScore = score;
      changedLast = true;
      state = dir > 0 ? "BRIGHTER" : "DARKER";
      return commit(next, now);
    }

    private double towardBaseline(double now) {
      double next = exposure > baseline ? Math.max(baseline, exposure / step)
          : Math.min(baseline, exposure * step);
      changedLast = false;
      lastScore = Double.NaN;
      state = "RELAX";
      return commit(next, now);
    }

    private double commit(double next, double now) {
      exposure = next;
      lastChange = now;
      return next;
    }

    private double clamp(double e) {
      return Math.max(min, Math.min(max, e));
    }

    private void clearWindow() {
      expectedSamples = 0;
      detectedExpected = 0;
      detections = 0;
      frames = 0;
      fastFrames = 0;
      ambiguitySum = 0;
    }
  }

  // =====================================================================================
  /** Tags the camera should see from this pose (FOV, distance and viewing-angle limits). */
  public static Set<Integer> visibleTags(List<AprilTag> tags, Pose3d camera, double hfovDeg,
      double vfovDeg, double maxDistance, double maxViewAngleDeg) {
    Set<Integer> out = new HashSet<>();
    double margin = 3.0; // deg - tags right at the edge are often clipped
    double cosMax = Math.cos(Math.toRadians(maxViewAngleDeg));
    for (AprilTag tag : tags) {
      Transform3d camToTag = new Transform3d(camera, tag.pose);
      Translation3d t = camToTag.getTranslation();
      double d = t.getNorm();
      if (t.getX() <= 0 || d < 0.3 || d > maxDistance) {
        continue;
      }
      double yaw = Math.toDegrees(Math.atan2(t.getY(), t.getX()));
      double pitch = Math.toDegrees(Math.atan2(t.getZ(), t.getX()));
      if (Math.abs(yaw) > hfovDeg / 2 - margin || Math.abs(pitch) > vfovDeg / 2 - margin) {
        continue;
      }
      // the tag's +X axis points out of its face; the camera must be in front of it
      Translation3d normal = new Translation3d(1, 0, 0).rotateBy(tag.pose.getRotation());
      Translation3d toCam = camera.getTranslation().minus(tag.pose.getTranslation());
      double cos = (normal.getX() * toCam.getX() + normal.getY() * toCam.getY()
          + normal.getZ() * toCam.getZ()) / Math.max(toCam.getNorm(), 1e-9);
      if (cos < cosMax) {
        continue;
      }
      out.add(tag.ID);
    }
    return out;
  }

  /** Limelight "rawfiducials": [id, txnc, tync, ta, distToCamera, distToRobot, ambiguity] per tag. */
  public static Map<Integer, Double> parseRawFiducials(double[] raw) {
    Map<Integer, Double> out = new HashMap<>();
    for (int i = 0; i + 6 < raw.length; i += 7) {
      out.put((int) raw[i], raw[i + 6]);
    }
    return out;
  }

  // =====================================================================================
  private final Config cfg;
  private final Controller controller;
  private final List<AprilTag> tags;
  private final NetworkTableEntry rawFiducials;
  private final NetworkTableEntry heartbeat;
  private final NetworkTable telemetry;
  private final NetworkTableEntry enabledEntry;
  private final ExecutorService http;
  private final AtomicReference<Double> pending = new AtomicReference<>(null);
  private final AtomicInteger failures = new AtomicInteger();
  private double lastHeartbeat = Double.NaN;
  private boolean hold = false;
  private boolean wasEnabled = false;
  private int expectedCount = 0;

  public LimelightAdaptiveExposure(Config cfg) {
    this(cfg, AprilTagFieldLayout.loadField(AprilTagFields.kDefaultField));
  }

  public LimelightAdaptiveExposure(Config cfg, AprilTagFieldLayout layout) {
    this.cfg = cfg;
    this.controller = new Controller(cfg.baselineRaw, cfg.minFactor, cfg.maxFactor, cfg.stepFactor,
        cfg.windowSec, cfg.settleSec);
    this.tags = layout.getTags();
    NetworkTable ll = NetworkTableInstance.getDefault().getTable(cfg.name);
    this.rawFiducials = ll.getEntry("rawfiducials");
    this.heartbeat = ll.getEntry("hb");
    this.telemetry = NetworkTableInstance.getDefault().getTable("AdaptiveExposure").getSubTable(cfg.name);
    this.enabledEntry = telemetry.getEntry("enabled");
    this.enabledEntry.setDefaultBoolean(true);
    this.http = Executors.newSingleThreadExecutor(r -> {
      Thread t = new Thread(r, "LL-exposure-" + cfg.name);
      t.setDaemon(true);
      return t;
    });
  }

  /** Call once per robot loop (robotPeriodic) with the fused robot pose and robot-relative speeds. */
  public void update(Pose2d robotPose, ChassisSpeeds robotRelativeSpeeds) {
    double now = Timer.getFPGATimestamp();
    boolean enabled = DriverStation.isEnabled();
    if (!enabled && wasEnabled) {
      resetToBaseline(); // match over / robot disabled -> back to the tuned value
    }
    wasEnabled = enabled;
    boolean modeOk = (DriverStation.isAutonomous() && cfg.adaptInAuto)
        || (DriverStation.isTeleop() && cfg.adaptInTeleop);
    boolean active = enabled && modeOk && enabledEntry.getBoolean(true) && failures.get() < 5;

    double hb = heartbeat.getDouble(Double.NaN);
    boolean newFrame = Double.isNaN(hb) || hb != lastHeartbeat;
    lastHeartbeat = hb;
    if (active && newFrame) {
      Map<Integer, Double> detected = parseRawFiducials(rawFiducials.getDoubleArray(new double[0]));
      Set<Integer> expected = Set.of();
      if (robotPose != null) {
        Pose3d camera = new Pose3d(robotPose).transformBy(cfg.robotToCamera);
        expected = visibleTags(tags, camera, cfg.hfovDeg, cfg.vfovDeg, cfg.maxTagDistance,
            cfg.maxViewAngleDeg);
      }
      expectedCount = expected.size();
      boolean fast = robotRelativeSpeeds != null
          && (Math.abs(robotRelativeSpeeds.omegaRadiansPerSecond) > cfg.fastOmega
              || Math.hypot(robotRelativeSpeeds.vxMetersPerSecond,
                  robotRelativeSpeeds.vyMetersPerSecond) > cfg.fastSpeed);
      controller.addFrame(now, expected, detected, fast);
    }
    if (active) {
      double next = controller.update(now, hold);
      if (!Double.isNaN(next)) {
        send(next);
      }
    }
    publish(active);
  }

  /** Freeze the exposure (e.g. while auto-aiming or shooting). */
  public void setHold(boolean hold) {
    this.hold = hold;
  }

  /** Go back to the tuned exposure (call in autonomousInit; also happens automatically on disable). */
  public void resetToBaseline() {
    controller.reset();
    send(cfg.baselineRaw);
  }

  public double getExposureMs() {
    return controller.exposure() * UNIT_MS;
  }

  private void send(double raw) {
    pending.set(raw);
    http.execute(() -> {
      Double v = pending.getAndSet(null);
      if (v != null) {
        post(v);
      }
    });
  }

  private void post(double raw) {
    HttpURLConnection c = null;
    try {
      String value = cfg.integerValues ? Long.toString(Math.round(raw)) : Double.toString(raw);
      String body = "{\"" + cfg.exposureKey + "\":" + value + "}";
      // no "flush" parameter: the change is live only and never written to the Limelight's disk
      c = (HttpURLConnection) URI.create("http://" + cfg.host + ":5807/update-pipeline").toURL()
          .openConnection();
      c.setConnectTimeout(300);
      c.setReadTimeout(500);
      c.setRequestMethod("POST");
      c.setDoOutput(true);
      c.setRequestProperty("Content-Type", "application/json");
      try (OutputStream os = c.getOutputStream()) {
        os.write(body.getBytes(StandardCharsets.UTF_8));
      }
      int code = c.getResponseCode();
      if (code >= 200 && code < 300) {
        failures.set(0);
      } else {
        failures.incrementAndGet();
      }
    } catch (Exception e) {
      failures.incrementAndGet();
    } finally {
      if (c != null) {
        c.disconnect();
      }
    }
  }

  private void publish(boolean active) {
    telemetry.getEntry("exposure_ms").setDouble(controller.exposure() * UNIT_MS);
    telemetry.getEntry("baseline_ms").setDouble(cfg.baselineRaw * UNIT_MS);
    telemetry.getEntry("detection").setDouble(controller.lastDetection);
    telemetry.getEntry("ambiguity").setDouble(controller.lastAmbiguity);
    telemetry.getEntry("expected_tags").setDouble(expectedCount);
    telemetry.getEntry("state").setString(active ? controller.state
        : (failures.get() >= 5 ? "HTTP_ERROR" : "IDLE"));
    telemetry.getEntry("http_failures").setDouble(failures.get());
  }
}
